{
  "name": "xconfess",
  "private": true,
  "workspaces": [
    "xconfess-backend",
    "xconfess-contracts",
    "xconfess-frontend"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "npm run dev:check && concurrently \"npm run dev --workspace=xconfess-backend\" \"npm run dev --workspace=xconfess-frontend\"",
    "dev:check": "node scripts/check-local-services.js",
    "dev:services": "docker compose up -d postgres redis",
    "dev:backend": "npm run dev:check && npm run dev --workspace=xconfess-backend",
    "dev:frontend": "npm run dev --workspace=xconfess-frontend",
    "backend:build": "npm run build --workspace=xconfess-backend",
    "backend:test": "npm run test --workspace=xconfess-backend",
    "backend:test:e2e": "npm run test:e2e --workspace=xconfess-backend",
    "backend:lint": "npm run lint --workspace=xconfess-backend",
    "contract:build": "npm run build --workspace=xconfess-contracts",
    "contract:build:release": "npm run build:release --workspace=xconfess-contracts",
    "contract:test": "npm run test --workspace=xconfess-contracts",
    "contract:test:integration": "npm run test:integration --workspace=xconfess-contracts",
    "contract:lint": "npm run lint --workspace=xconfess-contracts",
    "contract:fmt": "npm run fmt --workspace=xconfess-contracts",
    "contract:fmt:check": "npm run fmt:check --workspace=xconfess-contracts",
    "contract:clean": "npm run clean --workspace=xconfess-contracts",
    "contract:deploy:testnet": "npm run deploy:testnet --workspace=xconfess-contracts",
    "build": "npm run backend:build && npm run frontend:build && npm run contract:build:release",
    "build:apps": "npm run backend:build && npm run frontend:build",
    "start:backend": "npm run start:prod --workspace=xconfess-backend",
    "start:frontend": "npm run start --workspace=xconfess-frontend",
    "test": "npm run backend:test && npm run contract:test",
    "lint": "npm run backend:lint && npm run contract:lint",
    "frontend:build": "npm run build --workspace=xconfess-frontend",
    "frontend:test": "npm run test --workspace=xconfess-frontend",
    "frontend:test:smoke": "npm run test:smoke --workspace=xconfess-frontend",
    "frontend:test:e2e": "npm run test:e2e --workspace=xconfess-frontend",
    "test:e2e": "npm run frontend:test:e2e",
    "seed": "npx ts-node -r tsconfig-paths/register --project tsconfig.seed.json scripts/seed.ts",
    "frontend:lint": "npm run lint --workspace=xconfess-frontend",
    "frontend:typecheck": "npm run typecheck --workspace=xconfess-frontend",
    "ci:backend": "npm run backend:build && npm run backend:lint && npm run backend:test",
    "ci:frontend": "npm run frontend:lint && npm run frontend:typecheck && npm run frontend:test && npm run frontend:build",
    "ci:contract": "npm run contract:fmt:check && npm run contract:lint && npm run contract:test && npm run contract:build:release",
    "ci:apps": "npm run backend:build && npm run backend:lint && npm run frontend:lint && npm run frontend:build",
    "ci": "npm run ci:backend && npm run ci:frontend && npm run ci:contract",
    "secret-scan": "./scripts/secret-scanning-preflight.sh",
    "secret-scan:self-test": "./scripts/secret-scanning-preflight.sh --self-test",
    "audit:ci": "npx audit-ci --config audit-ci.json",
    "audit:report": "npm audit --json > audit-report.json 2>&1 || true"
  },
  "dependencies": {
    "@faker-js/faker": "^10.2.0",
    "@nestjs-modules/ioredis": "^2.0.2",
    "@nestjs/common": "^11.1.17",
    "@nestjs/core": "^11.1.17",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/testing": "^11.1.5",
    "@nestjs/typeorm": "^11.0.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^14.4.3",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.79.0",
    "express": "^5.1.0",
    "ioredis": "^5.6.1",
    "lodash.bind": "^4.2.1",
    "lodash.defaults": "^4.2.0",
    "reflect-metadata": "^0.2.2",
    "sanitize-html": "^2.17.0",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-typescript": "^7.28.5",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "@types/sanitize-html": "^2.16.0",
    "babel-jest": "^30.2.0",
    "concurrently": "^8.2.2",
    "dotenv": "^16.4.0",
    "jest": "^30.0.5",
    "lodash": "^4.17.21",
    "minimatch": "^9.0.5",
    "sqlite3": "^6.0.1",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2"
  },
  "packageManager": "npm@10.9.3",
  "overrides": {
    "js-yaml": "4.3.1",
    "rxjs": "7.8.2"
  }
}
