{
  "name": "xconfess",
  "private": true,
  "workspaces": [
    "xconfess-backend",
    "xconfess-contracts",
    "xconfess-frontend"
  ],
  "engines": {
    "node": "22.x",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=xconfess-backend\" \"npm run dev --workspace=xconfess-frontend\"",
    "dev:backend": "npm run dev --workspace=xconfess-backend",
    "dev:frontend": "npm run dev --workspace=xconfess-frontend",
    "deploy:preflight": "node scripts/deploy-preflight.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-typescript": "^7.28.5",
    "@types/node": "^25.5.0",
    "concurrently": "^8.2.2",
    "dotenv": "^16.4.0",
    "minimatch": "^9.0.5",
    "ts-node": "^10.9.2"
  },
  "packageManager": "npm@10.9.3",
  "overrides": {
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "rxjs": "7.8.2"
  }
}
