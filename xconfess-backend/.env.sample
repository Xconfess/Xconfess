# ============================================================
# xConfess Backend — Environment Variables Sample
# ============================================================
# Copy this file to .env and fill in all values before running.
# NEVER commit your .env file — it is listed in .gitignore.
#
# For a full description of each variable, format requirements,
# and deployment checklists see:
#   docs/deployment-env-checklist.md
# ============================================================

# ------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------
DB_HOST=CHANGE_ME_db_hostname
DB_PORT=5432
DB_USERNAME=CHANGE_ME_db_username
DB_PASSWORD=CHANGE_ME_db_password
DB_NAME=xconfess

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
PORT=5000
NODE_ENV=development

# The full URL of the deployed frontend — no trailing slash.
# CRITICAL: must match your Vercel URL in production or CORS will block all requests.
# Example (production): https://xconfess.vercel.app
# Example (local dev):  http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------
# Security & Encryption
# Secrets must NEVER be committed to version control.
# ------------------------------------------------------------

# JWT signing secret — minimum 32 characters.
# Generate: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_at_least_32_char_random_string

# AES-256 key for encrypting confession content.
# Must be EXACTLY 32 characters.
# Generate: openssl rand -hex 16
CONFESSION_AES_KEY=CHANGE_ME_exactly_32_characters!!

# AES key for encrypting email verification tokens.
# Must be EXACTLY 32 characters.
# Generate: openssl rand -hex 16
EMAIL_ENCRYPTION_KEY=CHANGE_ME_exactly_32_characters!!

# ------------------------------------------------------------
# Email / SMTP (optional — required for email notifications)
# ------------------------------------------------------------
MAIL_HOST=smtp.ethereal.email
MAIL_PORT=587
# Set to "true" for port 465 (SSL), "false" for 587 (TLS)
MAIL_SECURE=false
MAIL_USER=CHANGE_ME_smtp_username
MAIL_PASSWORD=CHANGE_ME_smtp_password
MAIL_FROM=noreply@xconfess.app

# ------------------------------------------------------------
# Redis (optional — required for BullMQ job queues)
# Used by: notification queue, confession draft expiry
# ------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ------------------------------------------------------------
# Rate Limiting (optional — defaults shown)
# ------------------------------------------------------------
THROTTLE_TTL=900
THROTTLE_LIMIT=100
RATE_LIMIT_POST_MAX=5
RATE_LIMIT_POST_WINDOW=60
RATE_LIMIT_GET_MAX=50
RATE_LIMIT_GET_WINDOW=60

# ------------------------------------------------------------
# Stellar / Soroban (optional — required for blockchain features)
# See docs/SOROBAN_SETUP.md for contract deployment instructions.
# ------------------------------------------------------------
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org:443
# Must be exact — copy from: docs/deployment-env-checklist.md#stellar-testnet-reference-ids
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# 56-character Soroban contract ID starting with "C".
# Obtain after deploying: docs/SOROBAN_SETUP.md#deploy-to-stellar-testnet
CONFESSION_ANCHOR_CONTRACT=CHANGE_ME_56_char_contract_id_starting_with_C

# Stellar deployer secret key — NEVER commit this value.
# Only needed when running deploy scripts locally.
# Generate: stellar keys generate --global deployer --network testnet
DEPLOYER_SECRET_KEY=CHANGE_ME_56_char_secret_key_starting_with_S