{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "module": "Node16",
    "moduleResolution": "Node16",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "migrations/**/*.ts"],
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts", "**/*test.ts"]
}
